# ===== Quiz desk settings. START.bat repairs missing keys automatically. Never commit .env =====

# ---- Your books and index (relative paths are relative to this folder) ----
AGENTS_DIR=agents
CHROMA_PATH=data/chroma
VECTOR_STORE=chroma
QUIZ_COLLECTION_TEMPLATE={agent}
QUIZ_SOURCE_META_KEY=source

# ---- Embeddings (must match the model the index was built with) ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3:latest

# ---- The model that writes the questions: DEFAULT shown in the dashboard dropdown ----
# provider = ollama | groq | openrouter | gemini | custom
QUIZ_LLM_PROVIDER=ollama
QUIZ_LLM_MODEL=llama3.2:3b
# Put the key for the provider you use. (QUIZ_LLM_API_KEY works for the default provider.)
QUIZ_LLM_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Extra dropdown entries, comma separated, e.g. groq:openai/gpt-oss-20b,ollama:llama3.2:3b
QUIZ_MODELS=
# OPT-IN fallback if the main model is rate limited / down, e.g. ollama:llama3.2:3b (the dashboard says when it was used)
QUIZ_LLM_FALLBACK=

# ---- Reliability (safe defaults) ----
QUIZ_LLM_TIMEOUT=300
QUIZ_LLM_MAX_RETRIES=3
QUIZ_LLM_MAX_WAIT=60
QUIZ_LLM_MIN_INTERVAL=0
QUIZ_LLM_CACHE_TTL=60
QUIZ_LLM_MAX_OUTPUT=8192
QUIZ_LLM_REASONING_EFFORT=auto
QUIZ_OLLAMA_NUM_CTX=8192
QUIZ_OLLAMA_KEEP_ALIVE=30m

# ---- Reranker ----
RERANKER_ENABLED=true
RERANKER_PROVIDER=http
RERANKER_ENDPOINT=http://127.0.0.1:8765
RERANKER_TIMEOUT=120
RERANKER_FALLBACK=true
RERANK_MAX_CANDIDATES=24
RETRIEVAL_TOP_K=20
RERANKER_TOP_N=8

# ---- Quiz ----
QUIZ_DEFAULT_DIFFICULTY=medium
QUIZ_MAX_QUESTIONS=20
QUIZ_REGENERATION_LIMIT=2
QUIZ_ANSWERS_REQUIRE_ADMIN=false
QUIZ_OPEN_BROWSER=true
