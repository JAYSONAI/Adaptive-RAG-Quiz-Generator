# ---- Quiz agent: append to your .env ----
RETRIEVAL_TOP_K=20            # candidates per book, per retriever
RERANKER_TOP_N=8              # passages handed to the question writer
RERANKER_ENABLED=true
RERANKER_PROVIDER=http        # http (separate venv service, recommended) | flag (in-process) | none
RERANKER_MODEL=BAAI/bge-reranker-v2-m3   # or a local folder path
RERANKER_DEVICE=cpu           # cpu | cuda
RERANKER_ENDPOINT=http://127.0.0.1:8765
RERANKER_TIMEOUT=30
RERANKER_SERVICE_TOKEN=       # optional bearer token shared by app and service
RERANKER_FALLBACK=false       # true = fall back to retrieval order if the reranker fails (reported, never hidden)
QUIZ_DEFAULT_DIFFICULTY=medium
QUIZ_MAX_QUESTIONS=20
QUIZ_REGENERATION_LIMIT=2
QUIZ_SOURCE_META_KEY=source   # chunk metadata field that holds the file name
QUIZ_COLLECTION_TEMPLATE={agent}   # vector collection name per agent
QUIZ_ANSWERS_REQUIRE_ADMIN=false   # true = include_answers only with X-Admin-Token == ADMIN_TOKEN
QUIZ_ALLOW_CLIENT_POLICY=false
